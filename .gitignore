# pyenv
# Для библиотек этот файл можно игнорировать; для приложения обычно хранят в Git.
# .python-version

# pipenv
# Pipfile.lock обычно хранят в Git; учитывайте совместимость зависимостей между платформами.
#Pipfile.lock

# poetry
# poetry.lock обычно хранят в Git для воспроизводимой установки зависимостей приложения.
#   https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
#poetry.lock

# pdm
# pdm.lock также обычно хранят в Git.
#pdm.lock
# Локальные настройки проекта в .pdm.toml обычно не хранят в Git.
#   https://pdm.fming.dev/latest/usage/project/#working-with-version-control
.pdm.toml
.pdm-python
.pdm-build/

# Локальные пакеты по PEP 582, используемые pyflow и pdm
